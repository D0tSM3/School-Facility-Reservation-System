
# Supabase Postgres connection. From Settings -> Database -> Connect in your
# Supabase dashboard. The "Direct connection" host (db.<project-ref>.supabase.co)
# is IPv6-only unless you've enabled the IPv4 add-on — if your host/server can't
# reach it, use the Session Pooler host/port shown on the same page instead
# (still port 5432, but an aws-*.pooler.supabase.com host and a
# postgres.<project-ref> user).
DB_HOST=db.grtsfjxlnujknehnczcv.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

APP_TIMEZONE=Asia/Manila

# Optional. Set to bpu.edu.ph to restrict signup to institutional addresses.
ALLOWED_EMAIL_DOMAIN=bpu.edu.ph

# Google reCAPTCHA v2 (checkbox), protecting the unauthenticated auth routes.
# Get a pair at https://www.google.com/recaptcha/admin — register BOTH
# "localhost" and "127.0.0.1" as domains for local development.
#   SITE key   - public, served to the browser via GET /api/config
#   SECRET key - server only. Never put it in a file under public/.
# Leave RECAPTCHA_ENABLED=false (or the keys blank) and the checks are skipped
# entirely, which is what the automated test suites rely on.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=false

# Optional. Leave SMTP_HOST blank in development -
# AuthController returns dev_otp in the JSON response when SMTP is unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bpu.edu.ph
